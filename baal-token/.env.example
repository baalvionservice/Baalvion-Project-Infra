# Copy to .env for local use. .env is gitignored. Placeholders only: never
# commit real values, and never put private keys, seed phrases or keypair
# paths in any env var. Signing happens on a hardware wallet outside this repo.

# Network used by local tooling. Devnet is the default; mainnet is never
# selected through the environment (it requires an explicit --network flag).
SOLANA_NETWORK=devnet

# RPC endpoints (provider URLs may embed API keys, so keep them out of git).
SOLANA_RPC_URL=
DEVNET_RPC_URL=
MAINNET_RPC_URL=
