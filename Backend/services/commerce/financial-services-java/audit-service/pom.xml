<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.baalvion</groupId>
    <artifactId>baalvion-financial-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>audit-service</artifactId>
  <name>Audit Service</name>
  <description>Immutable, append-only audit trail and compliance log aggregation for Global Trade Infrastructure</description>

  <!-- spring-boot-starter-data-elasticsearch (below) transitively pulls
       httpcore5/httpcore5-h2 5.4.2, which has two HIGH CVEs (CVE-2026-54399,
       CVE-2026-54428 — DoS via excessive HTTP headers / oversized HTTP/2
       HPACK headers), both fixed starting 5.4.3 (confirmed against Maven
       Central's repository metadata directly — the search.maven.org search
       index was lagging and didn't have 5.4.3 indexed yet). No other module
       in this project depends on spring-boot-starter-data-elasticsearch, so
       this override is scoped to audit-service rather than the shared
       parent pom. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5</artifactId>
        <version>5.4.3</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5-h2</artifactId>
        <version>5.4.3</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.baalvion</groupId>
      <artifactId>common-security</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!-- Optional Elasticsearch audit indexing (active only when app.audit.search=elasticsearch).
         On the classpath; the ES health indicator is disabled by default so an unused ES never
         fails readiness (see TracingDefaultsEnvironmentPostProcessor). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
