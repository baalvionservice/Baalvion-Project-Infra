PORT=3025
NODE_ENV=development

# ── Firebase Admin SDK (required) ────────────────────────────────────────────
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:9003,http://localhost:3000
RATE_LIMIT_IP_MAX=120
JWT_ACCESS_SECRET=replace-with-strong-secret

# ── Service metadata ─────────────────────────────────────────────────────────
SERVICE_NAME=trade-service

# ── Freight carrier API credentials (optional) ───────────────────────────────
# Each coded carrier connector (service/freight/connectors/*) calls the carrier's
# real API only when BOTH its ENDPOINT + API_KEY are set; otherwise it falls back
# to a deterministic simulator, so the freight marketplace works out of the box
# without any of these. Unset by default.
DHL_ENDPOINT=
DHL_API_KEY=
FEDEX_ENDPOINT=
FEDEX_API_KEY=
UPS_ENDPOINT=
UPS_API_KEY=
MAERSK_ENDPOINT=
MAERSK_API_KEY=
# Any carrier added dynamically through the Carrier Directory
# (POST /v1/freight/carrier-directory) with no bespoke coded connector is served by
# GenericConnector (service/freight/connectors/genericConnector.js). Set its
# `credentialEnvPrefix` field (e.g. "MSC") to point it at real credentials —
# <PREFIX>_ENDPOINT + <PREFIX>_API_KEY — same fall-back-to-simulator rule applies
# when unset, so a new carrier can be onboarded and quoted immediately, live
# integration added later without a code change.

# ─────────────────────────────────────────────────────────────────────────────
# GOVERNMENT CUSTOMS GATEWAYS
#
# There is no simulator. A channel whose settings are incomplete REFUSES to
# transmit and names what is missing — it never returns a fake acknowledgement.
# Check integration status at GET /v1/customs_gateway/readiness.
#
# Certificates and keys are PATHS to PEM files, mounted at deploy time. Never
# commit the files themselves.
# ─────────────────────────────────────────────────────────────────────────────

# ── ICEGATE — Central Board of Indirect Taxes and Customs (CBIC), India
# Enrolment: ICEGATE registration + Message Exchange Facility (MEF) enrolment. Requires a Class-3 Digital Signature Certificate registered against the ICEGATE id.
# Message format: XML (Bill of Entry / Shipping Bill), digitally signed
# ICEGATE message-exchange submission endpoint — from: ICEGATE MEF enrolment pack
# [required]
ICEGATE_ENDPOINT=
# Endpoint for polling a filing status; defaults to the submission endpoint — from: ICEGATE MEF enrolment pack
# [optional]
ICEGATE_STATUS_ENDPOINT=
# Your registered ICEGATE user id — from: ICEGATE registration
# [required]
ICEGATE_ID=
# Customs location / port code you are filing at (e.g. INNSA1) — from: CBIC customs location directory
# [required]
ICEGATE_LOCATION_CODE=
# Mutual-TLS client certificate (PEM) — from: ICEGATE enrolment
# [required, path to PEM]
ICEGATE_CLIENT_CERT=
# Mutual-TLS client private key (PEM) — from: generated locally; CSR submitted at enrolment
# [required, SECRET, path to PEM]
ICEGATE_CLIENT_KEY=
# Passphrase for the client key, if encrypted
# [optional, SECRET]
ICEGATE_CLIENT_KEY_PASSPHRASE=
# CA bundle used to verify the ICEGATE server certificate — from: ICEGATE enrolment pack
# [required, path to PEM]
ICEGATE_CA_BUNDLE=
# Class-3 DSC public certificate (PEM) used to sign the message body — from: Licensed Indian Certifying Authority
# [required, path to PEM]
ICEGATE_DSC_CERT=
# DSC private key (PEM) — from: Licensed Indian Certifying Authority
# [required, SECRET, path to PEM]
ICEGATE_DSC_KEY=
# Passphrase for the DSC key
# [optional, SECRET]
ICEGATE_DSC_KEY_PASSPHRASE=

# ── CBP ACE — US Customs and Border Protection
# Enrolment: ABI (Automated Broker Interface) participation. Requires a CBP-assigned filer code and completion of ACE certification testing before production access is granted.
# Message format: CATAIR fixed-width records over the ABI channel
# ACE/ABI message submission endpoint — from: CBP client representative on ABI approval
# [required]
ACE_ENDPOINT=
# Endpoint for retrieving ABI response messages
# [optional]
ACE_STATUS_ENDPOINT=
# CBP-assigned three-character filer code — from: CBP on ABI approval
# [required]
ACE_FILER_CODE=
# ABI sender identifier used in the message header — from: CBP client representative
# [required]
ACE_SENDER_ID=
# Mutual-TLS client certificate (PEM) — from: CBP connectivity setup
# [required, path to PEM]
ACE_CLIENT_CERT=
# Mutual-TLS client private key (PEM)
# [required, SECRET, path to PEM]
ACE_CLIENT_KEY=
# Passphrase for the client key, if encrypted
# [optional, SECRET]
ACE_CLIENT_KEY_PASSPHRASE=
# CA bundle used to verify the CBP server certificate
# [required, path to PEM]
ACE_CA_BUNDLE=

# ── EU customs (national UCC system / ICS2) — National customs administration of the member state of declaration
# Enrolment: EORI registration plus per-member-state system enrolment. There is no single EU endpoint — declarations are lodged with the member state, so the endpoint and message version are member-state specific.
# Message format: UCC XML declaration; ICS2 for entry summary declarations
# Member-state declaration submission endpoint — from: National customs administration
# [required]
EU_CDS_ENDPOINT=
# Endpoint for retrieving declaration status notifications
# [optional]
EU_CDS_STATUS_ENDPOINT=
# ISO-2 code of the member state of declaration (decides endpoint and codelists) — from: your own customs registration
# [required]
EU_CDS_MEMBER_STATE=
# Your EORI number, used as the declarant identifier — from: EORI registration
# [required]
EU_CDS_EORI=
# Mutual-TLS client certificate (PEM) — from: member-state system enrolment
# [required, path to PEM]
EU_CDS_CLIENT_CERT=
# Mutual-TLS client private key (PEM)
# [required, SECRET, path to PEM]
EU_CDS_CLIENT_KEY=
# Passphrase for the client key, if encrypted
# [optional, SECRET]
EU_CDS_CLIENT_KEY_PASSPHRASE=
# CA bundle used to verify the member-state server certificate
# [required, path to PEM]
EU_CDS_CA_BUNDLE=
# Certificate for message-level signing, where the member state requires it in addition to mutual TLS
# [optional, path to PEM]
EU_CDS_SIGNING_CERT=
# Private key for message-level signing
# [optional, SECRET, path to PEM]
EU_CDS_SIGNING_KEY=

# ── Mirsal 2 — Dubai Customs
# Enrolment: Dubai Trade business registration with a customs client code, plus system-integration approval.
# Message format: XML declaration over the Dubai Trade integration channel
# Mirsal 2 declaration submission endpoint — from: Dubai Trade integration pack
# [required]
MIRSAL_ENDPOINT=
# Endpoint for polling declaration status
# [optional]
MIRSAL_STATUS_ENDPOINT=
# Dubai Customs client / business code — from: Dubai Trade registration
# [required]
MIRSAL_BUSINESS_CODE=
# Integration account username — from: Dubai Trade
# [required]
MIRSAL_USERNAME=
# Integration account password — from: Dubai Trade
# [required, SECRET]
MIRSAL_PASSWORD=
# Mutual-TLS client certificate (PEM)
# [required, path to PEM]
MIRSAL_CLIENT_CERT=
# Mutual-TLS client private key (PEM)
# [required, SECRET, path to PEM]
MIRSAL_CLIENT_KEY=
# Passphrase for the client key, if encrypted
# [optional, SECRET]
MIRSAL_CLIENT_KEY_PASSPHRASE=
# CA bundle used to verify the Dubai Trade server certificate
# [required, path to PEM]
MIRSAL_CA_BUNDLE=

# ── China International Trade Single Window — General Administration of Customs of China (GACC)
# Enrolment: GACC enterprise registration with a customs registration code, plus Single Window system access. Message signing uses a certificate issued by an approved Chinese CA.
# Message format: XML declaration over the Single Window channel, signed
# Single Window declaration submission endpoint — from: Single Window integration pack
# [required]
CHINA_SW_ENDPOINT=
# Endpoint for polling declaration status
# [optional]
CHINA_SW_STATUS_ENDPOINT=
# GACC customs registration code for the declaring enterprise — from: GACC enterprise registration
# [required]
CHINA_SW_CUSTOMS_CODE=
# Registered declarant / agent code — from: GACC enterprise registration
# [required]
CHINA_SW_DECLARANT_CODE=
# Mutual-TLS client certificate (PEM)
# [required, path to PEM]
CHINA_SW_CLIENT_CERT=
# Mutual-TLS client private key (PEM)
# [required, SECRET, path to PEM]
CHINA_SW_CLIENT_KEY=
# Passphrase for the client key, if encrypted
# [optional, SECRET]
CHINA_SW_CLIENT_KEY_PASSPHRASE=
# CA bundle used to verify the Single Window server certificate
# [required, path to PEM]
CHINA_SW_CA_BUNDLE=
# Message-signing certificate (PEM) from an approved CA — from: approved Chinese certification authority
# [required, path to PEM]
CHINA_SW_SIGNING_CERT=
# Message-signing private key (PEM)
# [required, SECRET, path to PEM]
CHINA_SW_SIGNING_KEY=
# Passphrase for the signing key
# [optional, SECRET]
CHINA_SW_SIGNING_KEY_PASSPHRASE=
