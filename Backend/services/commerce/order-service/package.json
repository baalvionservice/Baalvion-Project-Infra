{
  "name": "order-service",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "version": "1.0.0",
  "description": "Baalvion Enterprise Order Management Service",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "migrate": "sequelize-cli db:migrate && node ../../../packages/payment-consistency/scripts/migrate.mjs",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "test": "node --test --test-force-exit tests/*.test.js"
  },
  "dependencies": {
    "@baalvion/auth-node": "workspace:*",
    "@baalvion/commerce-rbac": "workspace:*",
    "@baalvion/events": "workspace:*",
    "@baalvion/graceful-shutdown": "workspace:*",
    "@baalvion/money": "workspace:*",
    "@baalvion/payment-consistency": "workspace:*",
    "@baalvion/sites": "workspace:*",
    "@baalvion/telemetry": "workspace:*",
    "bullmq": "^5.52.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.2"
  }
}
