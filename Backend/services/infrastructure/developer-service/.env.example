NODE_ENV=development
PORT=3042
CORS_ORIGINS=http://localhost:3000,http://localhost:3030,http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=developer
DATABASE_URL=postgres://baalvion:CHANGE_ME@localhost:5432/baalvion_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
EVENT_BUS_STREAM=baalvion:events
DEVELOPER_CONSUME_EVENTS=true

WEBHOOK_DELIVERY=true
WEBHOOK_TICK_MS=5000
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=8000

# No JWT_PUBLIC_KEY → HS256 dev fallback using the shared dev secret (tokens verify locally)
JWT_ISSUER=baalvion-auth
JWT_AUDIENCE=baalvion-platform
JWT_ACCESS_SECRET=CHANGE_ME

INTERNAL_API_KEY=CHANGE_ME
LOG_LEVEL=info

# Self-serve billing (baalvion-intelligence). Get Key ID/Secret from the Razorpay Dashboard
# (Settings -> API Keys), and register a webhook (Settings -> Webhooks) pointed at
# https://developer-api.baalvion.com/v1/billing/razorpay-webhook subscribed to `payment.captured`
# and `order.paid`, then fill these in. Until RAZORPAY_KEY_ID/KEY_SECRET are set, checkout order
# creation 503s; until RAZORPAY_WEBHOOK_SECRET is set, the webhook route rejects everything (401)
# instead of silently no-op'ing on a real charge.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# INR if your Razorpay account isn't enabled for international/USD payments — see the go-live
# checklist for how this affects the marketed $19/$79/$299 prices.
RAZORPAY_CURRENCY=USD
