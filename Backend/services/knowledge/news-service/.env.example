PORT=3045
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3070,http://localhost:3030

# Canonical RS256 verification for /v1/admin/* (shared with auth-service)
JWT_ISSUER=baalvion-auth
JWT_AUDIENCE=baalvion-platform
JWKS_URI=http://localhost:3001/.well-known/jwks.json
JWT_PUBLIC_KEY=replace-with-shared-platform-public-key

DEVELOPER_SERVICE_URL=http://localhost:3042
INTERNAL_API_KEY=replace-with-shared-internal-key
QUOTA_FREE_DAILY_LIMIT=100
QUOTA_KEY_CACHE_TTL_SECONDS=30
INGESTION_POLL_INTERVAL_MS=300000
RATE_LIMIT_IP_MAX=120
