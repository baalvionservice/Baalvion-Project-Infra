# CMS Service — Port 3018
PORT=3018
NODE_ENV=development
SERVICE_VERSION=1.0.0

# JWT verification (RS256 — auth-service issues tokens via @baalvion/auth-node).
# PEM public key (escape newlines as \n on a single line, or provide a JWKS URI).
JWT_PUBLIC_KEY=
JWT_ISSUER=baalvion-auth
JWT_AUDIENCE=baalvion-platform
# BAALVION_JWKS_URI=http://localhost:3001/.well-known/jwks.json

# PostgreSQL (shared Baalvion DB; cms owns the `cms` schema)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3030,http://localhost:5173

# Cache TTLs (seconds)
CACHE_CONTENT_TTL=300
CACHE_PUBLIC_TTL=600
CACHE_TAXONOMY_TTL=1800

# Rate limiting
RATE_LIMIT_IP_MAX=200

# Downstream services
MEDIA_SERVICE_URL=http://localhost:3012
NOTIFICATION_SERVICE_URL=http://localhost:3013

# ── Market Data (optional external feeds) ──
# Each is independently optional — a missing key just leaves that data slice empty,
# the newsroom dashboard never fails to load. All 4 have free tiers.
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=

# ── Media library (service/mediaService.js) ──
# Storage driver for uploaded media: 'local' (dev, cms-service/uploads/ served at
# /uploads) or 'minio' (S3-compatible object storage).
MEDIA_DRIVER=local
MEDIA_MAX_BYTES=52428800
# Public origin uploaded-media URLs are built against — must be THIS service's
# reachable origin when MEDIA_DRIVER=local.
CMS_PUBLIC_URL=http://localhost:3011
# S3_ENDPOINT / S3_BUCKET / S3_REGION / S3_ACCESS_KEY / S3_SECRET_KEY / S3_PUBLIC_URL
# are required when MEDIA_DRIVER=minio (see utils/s3Client.js).
S3_BUCKET=cms-media
# Every raster upload (jpeg/png/webp — svg and gif pass through untouched) is
# resized to this max width and re-encoded to WebP before it's ever stored, so
# page views never ship an original, unoptimized camera/screenshot upload. This
# is what keeps origin bandwidth (e.g. Vercel's Fast Origin Transfer quota) sane
# now that images.unoptimized=true bypasses Vercel's own metered image optimizer
# on imperialpedia (see Frontend/Imperialpedia-main/next.config.ts).
MEDIA_IMAGE_MAX_WIDTH=1600
MEDIA_IMAGE_QUALITY=80

# ── On-publish revalidation (push edits live to the frontends) ──
# When content is published / unpublished / edited live, cms-service busts the
# public delivery cache AND calls each website's frontend revalidate webhook so
# build-cached (ISR) pages refresh immediately. Both vars unset → webhook is a
# no-op (dynamic / no-store sites still pick edits up on the next request).
# REVALIDATE_SECRET must match each frontend's REVALIDATE_SECRET.
REVALIDATE_SECRET=
# JSON map of websiteSlug -> the frontend's /api/revalidate URL.
# REVALIDATE_WEBHOOKS={"imperialpedia":"https://imperialpedia.baalvion.com/api/revalidate","about-baalvion":"https://about.baalvion.com/api/revalidate","baalvion-ir":"https://ir.baalvion.com/api/revalidate","law-elite-network":"https://lawelitenetwork.com/api/revalidate"}
REVALIDATE_WEBHOOKS=
REVALIDATE_TIMEOUT_MS=5000

# ── @baalvion/sdk platform wiring ──
# Shared service-to-service secret. REQUIRED in non-development (the service
# refuses to start with the dev default outside NODE_ENV=development) — it guards
# the decrypted-keys resolver. CMS still stores tenant provider keys encrypted in
# its own vault; this is the inter-service auth secret, not a provider key.
INTERNAL_SERVICE_SECRET=baalvion-internal-dev-secret
# Self CMS hub base (the SDK config-resolver target). Defaults to the local port.
CMS_BASE_URL=http://localhost:3018/api/v1
# Domain event transport. The platform backbone is Redis Streams (baalvion:events),
# consumed by notification-service + audit-service. redis = real delivery; noop = log-only.
# Options: redis | nats | kafka | noop. Requires REDIS_* above when 'redis'.
EVENT_TRANSPORT=redis
# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
