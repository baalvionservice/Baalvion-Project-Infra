NODE_ENV=development
PORT=3021

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Cross-estate payment panel ────────────────────────────────────────────────
# Consume `payment.recorded` from the event bus into admin.payment_records — the
# table the "All properties" payments page reads. Off by default; this is the
# switch that makes that page show data.
PAYMENT_RECORDS_CONSUMER=false

# ── Legal entity ──────────────────────────────────────────────────────────────
# Which company's books a site's money belongs in. Resolution order:
#   LEGAL_ENTITY_<SITE_ID>  →  the site's registry field  →  LEGAL_ENTITY_DEFAULT
# Unset means genuinely unassigned, and is reported as such rather than being
# filled with a placeholder — a placeholder looks like a decision that was made.
LEGAL_ENTITY_DEFAULT=
# LEGAL_ENTITY_GTI=baalvion-sg

# ── Event stream ──────────────────────────────────────────────────────────────
# Approximate cap on the Redis event stream. Unbounded growth is not a
# configuration, it is a slow outage. Defaults to 1,000,000.
EVENT_STREAM_MAXLEN=1000000
