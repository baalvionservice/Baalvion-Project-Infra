NODE_ENV=development
PORT=3021

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Cross-estate payment panel ────────────────────────────────────────────────
# Consume `payment.recorded` from the event bus into admin.payment_records — the
# table the "All properties" payments page reads. Off by default; this is the
# switch that makes that page show data.
PAYMENT_RECORDS_CONSUMER=false

# ── Legal entity ──────────────────────────────────────────────────────────────
# Which company's books a site's money belongs in. Resolution order:
#   LEGAL_ENTITY_<SITE_ID>  →  the site's registry field  →  LEGAL_ENTITY_DEFAULT
# Unset means genuinely unassigned, and is reported as such rather than being
# filled with a placeholder — a placeholder looks like a decision that was made.
LEGAL_ENTITY_DEFAULT=
# LEGAL_ENTITY_GTI=baalvion-sg

# ── Event stream ──────────────────────────────────────────────────────────────
# Approximate cap on the Redis event stream. Unbounded growth is not a
# configuration, it is a slow outage. Defaults to 1,000,000.
EVENT_STREAM_MAXLEN=1000000

# ── Status prober / Mission Control ───────────────────────────────────────────
# Probes every property and service the catalog + site registry declare, records
# incidents on state transitions, and pushes to ntfy. Off by default.
STATUS_PROBER=false
# Where to reach services from. 'localhost' on a dev box; 'container' in production,
# which resolves each service at its compose hostname (app-identity, app-platform, …).
PROBE_INTERNAL_HOST=localhost
STATUS_PROBE_INTERVAL_MS=60000
STATUS_PROBE_CONCURRENCY=8
# Retained probe history. Rows are derived and rebuildable, so this only bounds disk.
STATUS_PROBE_RETAIN_DAYS=30
# Consecutive failures before an incident opens, and successes before it resolves.
# These are the flap suppression: at the defaults a single bad probe alerts nobody.
PROBE_FAILURE_THRESHOLD=3
PROBE_RECOVERY_THRESHOLD=2
# Above this many state changes in ONE sweep the failure is correlated, not
# independent, and arrives as a single digest instead of one push per target.
STATUS_DIGEST_THRESHOLD=3
# Response slower than this is 'degraded' rather than 'up'.
PROBE_DEGRADED_MS=1500
PROBE_TIMEOUT_MS=5000
# Hours without a successful capture before a payment-taking site reads 'degraded'.
PROBE_MONEY_STALE_HOURS=48

# ── Alerting (ntfy) ───────────────────────────────────────────────────────────
# THE topic your phone subscribes to. Unset means incidents are still recorded but
# NOTHING reaches you — the console says so in a banner rather than looking healthy.
# Treat the topic name as a secret: anyone who knows it can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Only for a self-hosted/authenticated ntfy.
NTFY_TOKEN=
# Deep link in the push notification.
ADMIN_CONSOLE_URL=https://admin.baalvion.com/status

# ── Dead-man's switch ─────────────────────────────────────────────────────────
# The prober runs inside this service, so it cannot report its own death. Point this
# at an external monitor (healthchecks.io or similar) that alerts when the pings STOP.
# Without it, a total failure of this box is silent.
STATUS_HEARTBEAT_URL=
