# CanWeMarry service — copy to .env for local development.
# Never commit a filled-in copy; .env is gitignored at the repo root.

NODE_ENV=development
PORT=3070

# The web app's origin. Credentialed CORS requires an explicit list, never a wildcard.
CORS_ORIGINS=http://localhost:3071

# ── Database ─────────────────────────────────────────────────────────────────
# The service owns the `canwemarry` schema inside the shared platform database and
# reads nothing outside it (system contract rules C1/C2).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=
DB_SCHEMA=canwemarry

# ── Identity ─────────────────────────────────────────────────────────────────
# Verification key only. This service never signs a token — auth-service is the
# platform's single issuer. Generate a local keypair with `pnpm run generate:keys`.
JWT_PUBLIC_KEY=
JWT_ISSUER=baalvion-auth
JWT_AUDIENCE=baalvion-platform
# Preferred over a static key once the JWKS endpoint is reachable.
BAALVION_JWKS_URI=

# ── Safety and limits ────────────────────────────────────────────────────────
RATE_LIMIT_IP_MAX=240
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_REPORT_MAX=10

# Salts the IP/user-agent hashes in the audit trail. Without it those columns are left
# null rather than written unsalted — an unsalted IP hash is trivially reversible.
AUDIT_HASH_SECRET=

# The one account granted ADMIN, so a fresh deployment has someone who can appoint
# moderators. Everything else in the admin panel is unreachable until this is used once.
#
# This is the auth-service SUBJECT — the `sub` claim, a bigint string like "42" — NOT this
# service's local UUID, because the operator has to be able to set it before their account
# exists here. To find yours: register normally, sign in, then open
#   GET /api/canwemarry/v1/me
# through the gateway; the token's subject is what auth-service put in `sub`.
#
# Order does not matter: the grant is re-applied on every request, so setting this after
# the account already exists works. Unset it once real roles are in the database.
BOOTSTRAP_ADMIN_USER_ID=

# ── Feature flags ────────────────────────────────────────────────────────────
# Site-wide public cases stay off until there is moderation capacity to support them.
ALLOW_PUBLIC_CASES=false
MAX_OPEN_CASES_PER_USER=3
