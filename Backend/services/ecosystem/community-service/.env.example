NODE_ENV=development
PORT=3064
CORS_ORIGINS=http://localhost:3000,https://community.marketunderworld.com

JWT_PUBLIC_KEY=
JWT_ISSUER=baalvion-auth
JWT_AUDIENCE=baalvion-platform
BAALVION_JWKS_URI=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379

# NodeBB Write API (server-to-server only — never exposed to any frontend)
NODEBB_BASE_URL=http://nodebb:4567
NODEBB_WRITE_API_TOKEN=

# Internal service-to-service auth (matches payment-service / other internal callers)
INTERNAL_SERVICE_SECRET=

# Paid-tier checkout (crypto USDT-TRC20 / BTC via payment-service — see PaymentGateway/CryptoGateway)
PAYMENT_SERVICE_URL=http://app-payments:3015

RATE_LIMIT_IP_MAX=120

# ── Payment spine ─────────────────────────────────────────────────────────────
# Report this site's payments onto the platform spine and drain its outbox.
# Off by default.
PAYMENT_SPINE=false

# ── Identity verification (KYC) ───────────────────────────────────────────────
# 32 random bytes, base64 (generate: openssl rand -base64 32). Encrypts ID scans and selfies at
# rest (AES-256-GCM). REQUIRED for KYC: without it /kyc returns 503. BACK THIS KEY UP; losing it
# makes every stored document unreadable. Rotating it requires re-encrypting or purging first.
KYC_ENCRYPTION_KEY=
# Months an approval stays valid (default 24).
KYC_VALIDITY_MONTHS=24
# Days after a decision that ID documents are deleted by scripts/purge-kyc-documents.js (run daily).
KYC_DOC_RETENTION_DAYS=90

# ── Notifications (email + in-app) ────────────────────────────────────────────
# In-app notifications always work. Email goes through notification-service when BOTH of these are
# set (INTERNAL_SERVICE_SECRET above must equal notification-service's). Unset = email skipped,
# nothing breaks. Calls are fire-and-forget and never fail the action that triggered them.
NOTIFICATION_BASE_URL=
NOTIFICATION_API_PREFIX=/v1
NOTIFICATION_TIMEOUT_MS=4000
# Where "new request / needs review" alerts go (comma-separated). Without it admins only see
# queues in the console.
ADMIN_ALERT_EMAIL=
# Used to build links in emails.
SITE_URL=https://community.marketunderworld.com
