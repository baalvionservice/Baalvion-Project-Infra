    "@baalvion/events": "workspace:*",
    "@baalvion/graceful-shutdown": "workspace:*",
    "@baalvion/telemetry": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
