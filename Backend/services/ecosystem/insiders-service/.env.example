PORT=3050
NODE_ENV=development

# ── PostgreSQL (shared baalvion_db, dedicated `insiders` schema) ──────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=baalvion_dev_pass
DB_SCHEMA=insiders

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL_DAYS=30

# ── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
RATE_LIMIT_IP_MAX=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── File uploads (replaces Supabase Storage `elite-proofs` bucket) ────────────
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3050

# ── AI assistant (replaces ai-chat edge fn). OpenAI-compatible chat completions.
# Works with OpenAI, Anthropic-compatible gateways, Lovable AI gateway, etc.
AI_API_KEY=
AI_BASE_URL=https://ai.gateway.lovable.dev/v1
AI_MODEL=google/gemini-2.5-flash

# ── Membership tiers (USD) + upgrade proration window ─────────────────────────
TIER_FOUNDER=299
TIER_INVESTOR_PARTNER=499
UPGRADE_GRACE_DAYS=5

# ── Payments ─────────────────────────────────────────────────────────────────
# This service holds NO PSP keys. Checkout relays to the JVM payment-service, which owns the
# merchant credentials (set RAZORPAY_*/PAYU_*/CASHFREE_* THERE, not here) and resolves the
# provider per site from the CMS vault. Membership is granted only when payment-service calls
# back on POST /v1/billing/fulfill for a captured, signature-verified payment.
PAYMENT_SERVICE_URL=http://app-payments:3015
# The site's slug in the payment-service / CMS vault — selects which merchant account is charged.
PAYMENT_SITE_SLUG=baalvion-elite-circle
# Shared secret for BOTH legs of that server-to-server call. Must not be the dev default in
# production; the service refuses to start a checkout if it is.
INTERNAL_SERVICE_SECRET=

# ── Payment spine (cross-estate reporting) ───────────────────────────────────
# PAYMENT_SPINE=true records every fulfilled membership onto the platform payment spine and
# starts this service's outbox relay, so the payment appears on the admin panel alongside the
# other properties. Off by default: disabled it is a no-op that never touches the database.
PAYMENT_SPINE=false
# Redis carries the event bus the relay drains into (REDIS_URL wins if set).
REDIS_HOST=redis
REDIS_PORT=6379
