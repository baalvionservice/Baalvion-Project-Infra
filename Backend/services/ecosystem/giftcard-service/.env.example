NODE_ENV=development
PORT=3065
CORS_ORIGINS=http://localhost:3000,https://community.marketunderworld.com

JWT_PUBLIC_KEY=
JWT_ISSUER=baalvion-auth
JWT_AUDIENCE=baalvion-platform
BAALVION_JWKS_URI=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=baalvion_db
DB_USER=baalvion
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379

# Internal service-to-service auth (matches payment-service / other internal callers)
INTERNAL_SERVICE_SECRET=

# Gift card checkout (crypto USDT-TRC20 / ETH-BEP20 / BTC via payment-service)
PAYMENT_SERVICE_URL=http://app-payments:3015

# Reloadly — the one real, working supplier. Sign up at reloadly.com for a free sandbox
# Client ID/Secret (RELOADLY_ENV=sandbox), switch to production credentials + RELOADLY_ENV=production
# once ready to sell real inventory.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_ENV=sandbox

# AES-256-GCM key (32 bytes, hex or base64) for encrypting redeem codes at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GIFTCARD_CODE_ENCRYPTION_KEY=
GIFTCARD_CODE_ENCRYPTION_KEY_PREVIOUS=

RATE_LIMIT_IP_MAX=120
