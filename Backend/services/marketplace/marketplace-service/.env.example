# marketplace-service — Baalvion Invest (marketplace + deal room)
# Copy to .env for local development. NEVER commit real values.

PORT=3060
NODE_ENV=development
CORS_ORIGINS=http://localhost:3027

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=baalvion_db
DB_PASSWORD=

# RLS IS INERT UNLESS THIS IS THE NON-SUPERUSER ROLE. Postgres ignores row-level security for
# superusers, so running as the schema owner leaves every tenant policy switched off while
# appearing to work. Migration 006 grants this role; middleware/tenantConnection.js supplies the
# per-request tenant. See the README section "Tenant isolation (RLS)".
DB_USER=baalvion_app

# Platform review (approving a company) is inherently CROSS-ORG, and the CR-8-hardened policies
# deny the tenant bypass to DB_USER above — by design. A SEPARATE login role is what the policy
# allows to bypass. Unset, the admin review routes answer 503 rather than reporting other orgs'
# records as missing.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# ── Identity ──────────────────────────────────────────────────────────────────
# PEM body, or leave unset and point JWKS_URI at auth-service.
JWT_PUBLIC_KEY=

JWT_ISSUER=baalvion-auth
JWT_AUDIENCE=baalvion-platform

# Behind auth-gateway there is no bearer token — the gateway strips it and injects signed
# identity headers. Must match the gateway's secret or nothing verifies.
GATEWAY_SIGNING_SECRET=
# legacy | hybrid (default) | strict | rs256_only
ISLAND_AUTH_MODE=hybrid

# ── Data room storage ─────────────────────────────────────────────────────────
# local | s3. An unknown value throws rather than silently writing confidential documents
# to a pod disk.
DATA_ROOM_DRIVER=local
DATA_ROOM_PATH=./.data-room
DATA_ROOM_BUCKET=
DATA_ROOM_MAX_MB=25
# REQUIRED IN PRODUCTION: @baalvion/upload refuses uploads when no malware scanner is configured.
CLAMAV_HOST=
CLAMAV_PORT=

# ── Money seams — every one FAILS CLOSED when unset ───────────────────────────
# Without a provider, starting a signature or opening escrow is refused (503) rather than
# faked. There is no endpoint that can mark a signature signed or an escrow funded; only the
# provider webhooks below can.
ESIGN_PROVIDER=
ESIGN_API_URL=
ESIGN_API_KEY=
ESCROW_API_URL=
ESCROW_API_KEY=
ESCROW_WEBHOOK_SECRET=

# ── Compliance ────────────────────────────────────────────────────────────────
# Unset, onboarding runs a local deterministic screen. Wire these before real investors.
AML_SERVICE_URL=
KYC_SERVICE_URL=

# ── Platform services ─────────────────────────────────────────────────────────
AUDIT_SERVICE_URL=http://127.0.0.1:3032
# Shared key for internal service-to-service calls; empty disables them.
INTERNAL_API_KEY=

NOTIFICATION_SERVICE_URL=http://127.0.0.1:3031
# Must match notification-service's own INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=

# off suppresses counterparty notification fan-out from the deal room.
DEAL_NOTIFICATIONS=on

# ── Rate limiting ─────────────────────────────────────────────────────────────
MARKETPLACE_IP_RATE_LIMIT=120
MARKETPLACE_DEAL_WRITE_RATE_LIMIT=30
# /webhooks mounts ahead of the global IP limiter, so it carries its own. Providers retry.
MARKETPLACE_WEBHOOK_RATE_LIMIT=300
