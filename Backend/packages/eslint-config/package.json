{
  "name": "@baalvion/eslint-config",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "version": "1.0.0",
  "description": "The platform's shared ESLint flat configs. One place decides how every app is linted, so an ESLint major, a rule change, or a new app is a single edit here instead of 22.",
  "private": true,
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./next": "./next.js",
    "./react": "./react.js",
    "./node": "./node.js"
  },
  "files": ["base.js", "next.js", "react.js", "node.js"],
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.4"
  }
}
