{
  "name": "@baalvion/ledger",
  "version": "1.0.0",
  "description": "Chart of accounts and double-entry posting rules \u2014 what journal lines a payment, a refund, a settlement and a revenue recognition produce. Pure and balanced by construction.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@baalvion/money": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  }
}
