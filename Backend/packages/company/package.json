{
  "name": "@baalvion/company",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "version": "1.0.0",
  "description": "The one source of truth for who this company legally is — registered name, CIN, addresses and IR contact — so no two properties can describe the same entity differently.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  }
}
