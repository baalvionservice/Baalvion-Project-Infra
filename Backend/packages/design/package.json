{
  "name": "@baalvion/design",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "version": "1.0.0",
  "description": "The shared quality bar for every Baalvion frontend — fluid type scale, spacing rhythm, tinted elevation, motion and state primitives. Palette and personality stay per-site.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./tailwind-preset.d.ts",
      "default": "./tailwind-preset.cjs"
    },
    "./base.css": "./styles/base.css",
    "./identity.css": "./styles/identity.css",
    "./styles/base.css": "./styles/base.css",
    "./styles/identity.css": "./styles/identity.css"
  },
  "files": [
    "dist",
    "styles",
    "tailwind-preset.cjs",
    "tailwind-preset.d.ts",
    "tailwind.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1",
    "react": "^19.2.1",
    "@types/react": "^19.0.0",
    "tailwindcss": "^3.4.17"
  }
}
