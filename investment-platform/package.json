{
  "name": "baalvion-investment-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Global investment platform \u2014 NestJS + Next.js 15 + Prisma/PostgreSQL",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "db:generate": "pnpm --filter @baalvion-invest/database generate",
    "db:migrate": "pnpm --filter @baalvion-invest/database migrate",
    "db:migrate:deploy": "pnpm --filter @baalvion-invest/database migrate:deploy",
    "db:studio": "pnpm --filter @baalvion-invest/database studio",
    "db:validate": "pnpm --filter @baalvion-invest/database validate",
    "db:format": "pnpm --filter @baalvion-invest/database format",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "postcss": "8.5.23",
      "ws@8": "8.21.0",
      "multer": "2.3.0",
      "js-yaml": "4.3.2",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "fast-uri": "3.1.6",
      "socket.io-parser": "4.2.7",
      "sharp": "0.35.4",
      "body-parser": "2.3.0",
      "next": "15.5.24",
      "browserslist": "4.28.7",
      "deepmerge-ts": "8.0.0",
      "nanoid": "3.3.18",
      "baseline-browser-mapping": "2.11.0",
      "qs": "6.16.0"
    }
  }
}
