# Environment Configuration Example
# Copy this to .env.local and fill in your actual values

# App Configuration
NEXT_PUBLIC_APP_NAME=Imperialpedia
NEXT_PUBLIC_SITE_URL=https://imperialpedia.com
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_API_BASE_URL=https://api.imperialpedia.com

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=contact@imperialpedia.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@imperialpedia.com
NEXT_PUBLIC_EXPERTS_EMAIL=experts@imperialpedia.com

# Google Analytics & Consent
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense Configuration (REQUIRED for monetization)
# Get your Publisher ID from Google AdSense: https://www.google.com/adsense/
# Format: ca-pub-xxxxxxxxxxxxxxxx
# Actual var read by the app is NEXT_PUBLIC_ADSENSE_CLIENT (see
# src/services/data/cms-public.ts) — this name must match exactly or the
# loader falls back to the hardcoded DEFAULT_ADSENSE_CLIENT.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# CMS Configuration
NEXT_PUBLIC_CMS_SITE_SLUG=imperialpedia
NEXT_PUBLIC_CMS_API_URL=https://cms.imperialpedia.com
CMS_API_KEY=your-cms-api-key

# imperialpedia-service (assets/entities/creators/world-config/newsletter, etc.)
# Every loader that calls it already defaults to this same public gateway route
# in production if unset, so this var only needs setting to override that
# default (e.g. pointing at a staging gateway) — but it's listed here so a
# deploy config doesn't have to go read the source to find the right value.
NEXT_PUBLIC_IMPERIALPEDIA_API_URL=https://api.baalvion.com/api/v1/knowledge/imperialpedia/api/v1

# On-publish revalidation + fast indexing (see src/app/api/revalidate/route.ts)
# Without these two set, publishing content still updates the public cache, but
# skips the near-real-time path entirely: ISR pages wait out their normal TTL
# instead of revalidating on publish, and Google/Bing are never pinged via
# IndexNow — both silently degrade to "wait for the next crawl" instead of
# erroring, so a missing var here is easy to miss.
# Must match cms-service's REVALIDATE_SECRET exactly (see that service's
# .env.example) — cms-service calls this frontend's /api/revalidate with it
# as the `x-revalidate-secret` header after every publish/update/delete.
REVALIDATE_SECRET=your-revalidate-secret
# IndexNow key (any string you generate) — also served at /<key>.txt via
# middleware.ts for Bing/Yandex (and Google, via the shared protocol) to
# verify domain ownership before trusting pings from /api/revalidate.
INDEXNOW_KEY=your-indexnow-key

# Database & Services
DATABASE_URL=postgresql://user:password@localhost:5432/imperialpedia
REDIS_URL=redis://localhost:6379

# Auth Configuration
NEXT_PUBLIC_AUTH_URL=https://auth.imperialpedia.com
AUTH_SECRET=your-auth-secret

# Feature Flags
NEXT_PUBLIC_ENABLE_PREMIUM=true
NEXT_PUBLIC_ENABLE_AFFILIATE_LINKS=true
# Note: the glossary/topics surface is NOT controlled by an env var — it's a
# hardcoded constant (GLOSSARY_LIVE in src/config/glossary.ts), kept off
# pending AdSense approval and real term content. Flip that constant, not an
# env var, when the glossary is ready to go live.
