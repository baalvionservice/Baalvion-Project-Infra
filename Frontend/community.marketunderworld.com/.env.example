# Server-only upstream addresses (no NEXT_PUBLIC_ prefix on purpose, so they never reach the
# browser bundle). Set these in the deploy environment; the app keeps no built-in default.
COMMUNITY_UPSTREAM_URL=
COMMERCE_UPSTREAM_URL=
ORDER_UPSTREAM_URL=
WALLET_UPSTREAM_URL=
WISHLIST_UPSTREAM_URL=
GIFTCARD_UPSTREAM_URL=
ADMIN_UPSTREAM_URL=
OAUTH_AUTHORIZE_URL=

# Same-origin auth proxy target (next.config.ts rewrite): the identity gateway's /v1 base.
AUTH_PROXY_TARGET=

# Public. Realtime chat connects from the browser, so this must be a neutral hostname you control.
NEXT_PUBLIC_REALTIME_WS_URL=

# Public. The marketplace store id (must match MARKETPLACE_STORE_ID on commerce-service and order-service).
NEXT_PUBLIC_MU_STORE_ID=
