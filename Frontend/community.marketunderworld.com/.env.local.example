# ─── AWS SES Email Configuration ─────────────────────────────────────────────
# Amazon SES (Simple Email Service) — used for all booking confirmation emails.
#
# SETUP STEPS:
# 1. Go to AWS Console → SES → Verified Identities
# 2. Verify your domain (e.g. baalvion.com) OR verify individual emails
# 3. If account is in SES Sandbox, request production access (AWS Support)
# 4. Create IAM user with AmazonSESFullAccess (or ses:SendEmail) permission
# 5. Generate Access Keys for that IAM user and paste below
#
# RECOMMENDED REGION: ap-south-1 (Mumbai) — lowest latency for India users

AWS_REGION=ap-south-1

# IAM user credentials with ses:SendEmail permission
# On EC2/ECS: leave EMPTY — SDK auto-picks up the instance/task IAM role
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address — must be verified in SES
SES_FROM_EMAIL=Baalvion Nightlife <noreply@baalvion.com>

# Where admin alert emails are sent (new booking notifications)
ADMIN_EMAIL=admin@baalvion.com

# Your public site URL (used in email buttons/links)
NEXT_PUBLIC_SITE_URL=https://community.marketunderworld.com

# ─── Backend API (optional — set when community backend is running) ───────────
# COMMUNITY_UPSTREAM_URL=http://your-backend-alb.ap-south-1.elb.amazonaws.com
