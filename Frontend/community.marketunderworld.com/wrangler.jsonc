{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-underworld-community",
  "account_id": "a5c9ac03bfd739a676807ce989ec37e2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Next.js's getMiddlewareManifest() does a dynamic require() of
    // .next/server/middleware-manifest.json, which the Workers runtime can't
    // support (fails with "Dynamic require ... is not supported" -> every
    // route 500s). This app has no middleware.ts, so minimal mode (which
    // skips that lookup) has no functional cost. See
    // https://github.com/opennextjs/opennextjs-cloudflare/issues/1232
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    // Server-only upstream API addresses read by the /api/*-proxy routes and server components.
    "COMMUNITY_UPSTREAM_URL": "https://api.baalvion.com/api/v1/community",
    "COMMERCE_UPSTREAM_URL": "https://api.baalvion.com/api/v1/commerce",
    "ORDER_UPSTREAM_URL": "https://api.baalvion.com/api/v1/orders",
    "WALLET_UPSTREAM_URL": "https://api.baalvion.com/api/wallets",
    "WISHLIST_UPSTREAM_URL": "https://api.baalvion.com/api/v1/wishlists",
    "GIFTCARD_UPSTREAM_URL": "https://api.baalvion.com/api/v1/giftcards",
    "ADMIN_UPSTREAM_URL": "https://api.baalvion.com/api/v1",
    "OAUTH_AUTHORIZE_URL": "https://api.baalvion.com/oidc-provider/oauth/authorize"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "community.marketunderworld.com", "custom_domain": true },
    { "pattern": "www.community.marketunderworld.com", "custom_domain": true }
  ]
}
