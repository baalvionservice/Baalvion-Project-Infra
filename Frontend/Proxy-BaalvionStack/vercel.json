{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "npx turbo-ignore proxy-baalvionstack-web",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=proxy-baalvionstack-web",
  "routes": [
    { "src": "/auth-bff/(.*)", "dest": "https://api.baalvion.com/v1/auth/$1" },
    { "src": "/v1/(.*)", "dest": "https://api.baalvion.com/v1/$1" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
