# Cloudflare serves these headers for the static export.
# Mirror of the security headers that used to live in next.config.ts `headers()`,
# which does not run on a static host. Keep in sync with next.config.ts notes.
/*
  X-DNS-Prefetch-Control: on
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Analytics hosts are listed explicitly, never as a wildcard. Cloudflare INJECTS its own
  # beacon and the Google tag at the edge — the site's own bundle does not include them — so a
  # CSP that omits these silently blocks every one of them and the property reports no
  # traffic at all while looking perfectly healthy. That was the state here.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.google.com https://www.google.co.in; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'

# The OG card exports as an extensionless file; pin its type so social scrapers
# (and Cloudflare's asset server) treat it as a PNG instead of octet-stream.
/opengraph-image
  Content-Type: image/png
