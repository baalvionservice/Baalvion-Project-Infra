# CanWeMarry web — copy to .env.local for development.
# .env* is gitignored at the repo root; never commit a filled-in copy.

# The auth-gateway BFF, used SERVER-SIDE only: by the Next rewrites and by server
# components. The browser never sees this origin — every call it makes is same-origin
# (/auth-bff/* and /api/canwemarry/*) and proxied here, which keeps the session cookie
# first-party and avoids CORS entirely.
GATEWAY_ORIGIN=http://localhost:3099

# Optional: override the API base used by server components. Defaults to
# <GATEWAY_ORIGIN>/api/canwemarry/v1, which is where the gateway mounts this service.
# CANWEMARRY_API_BASE=

# Public origin of this app. Used for canonical URLs, the sitemap, Open Graph and JSON-LD,
# so it must be the real public host in production or every canonical points at localhost.
# Production: https://canwemarry.baalvion.com
NEXT_PUBLIC_SITE_URL=http://localhost:3071

# Set to 1 only in the container build; `next start` locally does not use the standalone bundle.
# BUILD_STANDALONE=1
