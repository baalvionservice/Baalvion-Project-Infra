# Copy to .env and fill in real values. Never commit the real .env file.
# docker-compose.yml reads these for the web container.

# CodeIgniter encryption_key — generate with: php -r "echo bin2hex(random_bytes(32));"
CI_ENCRYPTION_KEY=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Production database credentials override the docker-compose defaults when deploying.
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
