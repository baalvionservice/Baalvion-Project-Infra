RewriteEngine On
RewriteBase /

# Allow direct access to web-story directory or other assets
RewriteCond %{REQUEST_URI} ^/web-story
RewriteRule ^ - [L]

# Route all other requests through CodeIgniter front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L,QSA]

# Long-lived caching for static files. Overrides Cloudflare's 4h default browser TTL.
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(jpe?g|png|gif|webp|avif)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
