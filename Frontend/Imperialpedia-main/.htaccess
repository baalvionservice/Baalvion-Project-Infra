RewriteEngine On
RewriteBase /

# Allow direct access to web-story directory or other assets
RewriteCond %{REQUEST_URI} ^/web-story
RewriteRule ^ - [L]

# Route all other requests through CodeIgniter front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L,QSA]