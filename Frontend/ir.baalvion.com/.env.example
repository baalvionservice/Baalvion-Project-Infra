# IR-Baalvion environment template. Copy to .env.local for development.
# NEVER commit a real .env.local. Production values are injected at deploy time.

# ----------------------------------------------------------------------------
# Backend service URLs (SERVER-ONLY — used by /api/* BFF routes, never shipped to
# the browser). On Vercel these MUST be set or onboarding/contact/deal-room calls
# fail with "service temporarily unavailable" (the localhost defaults below only
# work in local dev). See deploy/ir-stack/README.md.
# ----------------------------------------------------------------------------
# ir-service (applications, eligibility, contact inbox, reports, events).
IR_SERVICE_URL=http://127.0.0.1:3008
# marketplace-service (deal rooms / opportunities). Only needed for the deal-room flow.
MARKETPLACE_SERVICE_URL=http://127.0.0.1:3060

# ----------------------------------------------------------------------------
# Auth backend selection
# ----------------------------------------------------------------------------
# Path the auth client talks to. In production this MUST point at the real
# central gateway BFF (e.g. /auth-bff). Leave the local value ONLY in dev.
NEXT_PUBLIC_AUTH_BFF_PATH=/auth-bff

# Shared Baalvion sign-in surface. The primary "Sign In" control delegates here;
# users return via /auth/sso-callback. Defaults to the production host if unset.
NEXT_PUBLIC_AUTH_URL=https://auth.baalvion.com

# ----------------------------------------------------------------------------
# LOCAL (dev/standalone) auth backend — DEV ONLY, fail-closed in production
# ----------------------------------------------------------------------------
# The /api/auth-local routes are PERMANENTLY DISABLED when NODE_ENV=production.
# To use them in local dev you must opt in explicitly:
IR_LOCAL_AUTH_ENABLED=false

# Seed accounts for the local backend, as a JSON array. Server-only (not shipped
# to the browser). Set this ONLY in your own .env.local — never commit real values.
# Example (replace with throwaway dev passwords):
# IR_LOCAL_SEED_USERS=[{"id":"usr_admin","email":"dev-admin@example.test","password":"CHANGE_ME","name":"Dev Admin","role":"admin"}]
IR_LOCAL_SEED_USERS=

# Optional dev quick-login buttons in the login modal (JSON array). NEXT_PUBLIC_*
# is bundled into the client, so use throwaway dev credentials only and leave it
# unset in any shared/preview deployment.
# NEXT_PUBLIC_IR_DEV_QUICK_ACCOUNTS=[{"label":"Admin","email":"dev-admin@example.test","password":"CHANGE_ME"}]
NEXT_PUBLIC_IR_DEV_QUICK_ACCOUNTS=

# Refresh cookie name (must match the gateway).
NEXT_PUBLIC_REFRESH_COOKIE_NAME=baalvion_refresh

# ----------------------------------------------------------------------------
# Central CMS console (admin-platform) — drives /admin redirects + seed scripts
# ----------------------------------------------------------------------------
# Base URL of the CMS console (no trailing /websites segment). In production this
# MUST point at the real CMS; if unset in production the /admin redirect is
# skipped rather than sending users to localhost. Dev defaults to localhost.
NEXT_PUBLIC_CMS_URL=http://localhost:3030/cms
# This site's CMS website UUID (used to build the console URL and by seed scripts).
NEXT_PUBLIC_CMS_WEBSITE_ID=7bced69e-a861-4530-9660-e0ddb955d72b

# ----------------------------------------------------------------------------
# Public CMS delivery (SERVER-ONLY) — editorial content read from cms-service
# ----------------------------------------------------------------------------
# Public delivery API base. Production defaults to the gateway if unset; dev to
# the local cms-service. Code default in src/lib/cms.ts.
CMS_PUBLIC_URL=https://api.baalvion.com/api/v1/public
# This site's CMS slug. The central CMS registered IR as `baalvion-ir`
# (the local dev DB uses `ir.baalvion.com`).
CMS_WEBSITE_SLUG=baalvion-ir
# Shared secret for the on-publish revalidation webhook (must match cms-service's
# REVALIDATE_SECRET). Leave unset to disable instant ISR revalidation.
REVALIDATE_SECRET=
# Optional: IndexNow key for instant search-engine recrawl on publish.
INDEXNOW_KEY=

# ----------------------------------------------------------------------------
# Investor-side invitation gate (Companies Act, 2013 s.42) — see src/lib/invite-gate.ts
# ----------------------------------------------------------------------------
# A private limited company may not publicly solicit investment; a placement goes
# to IDENTIFIED PERSONS only. Each investor therefore gets their own invitation,
# issued with:
#
#     pnpm invite:new "Full Name" person@example.com [--expires YYYY-MM-DD]
#
# That prints the link to send them and the JSON entry to append below. Only the
# SHA-256 is stored — the code itself is shown once and is not recoverable, so a
# reader of this configuration cannot walk in. Revoke one person by deleting
# their entry; nobody else is affected.
#
# FAILS CLOSED: unset, empty or malformed means NO invitations resolve and both
# /invest and /onboarding redirect everyone to /invest/request-access.
# The founder side (/invest/list-your-business, /onboarding/business) is never gated.
#
# IR_INVEST_INVITES=[{"id":"inv_jane-doe_a1b2c3","label":"Jane Doe <jane@example.com>","sha256":"<64 hex>","expires":null}]
IR_INVEST_INVITES=

# Corporate site that holds the group-level legal policies the footer links to.
NEXT_PUBLIC_CORPORATE_URL=https://baalvion.com
