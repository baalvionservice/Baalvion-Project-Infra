# Every manifest now declares engines.node ">=24" and every image is node:24-*, so
# engine-strict is back on: an install on the wrong Node fails loudly instead of
# emitting a warning nobody reads. It was disabled while backend targeted Node 20 and
# some frontend deps wanted >=22; that split is gone. .nvmrc pins the version.
engine-strict=true
auto-install-peers=true
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling
shamefully-hoist=false
strict-peer-dependencies=false
